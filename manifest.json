{
  "id": "youtube_stats",
  "name": "YouTube Stats",
  "version": "1.0.0",
  "description": "Show a YouTube channel's subscribers, total views and video count. Uses your own free YouTube Data API key; no sign-in needed.",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--youtube-stats",
  "documentation": "README.md",
  "icon": "tv",
  "category": "entertainment",
  "fiestaboard_version": ">=9.5.0",
  "min_refresh_seconds": 300,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable YouTube Stats",
        "default": false
      },
      "api_key": {
        "type": "string",
        "title": "YouTube Data API Key",
        "description": "An API key from your own Google Cloud project with the YouTube Data API v3 enabled. Create one at console.cloud.google.com under APIs & Services > Credentials.",
        "ui:widget": "password"
      },
      "channel": {
        "type": "string",
        "title": "Channel",
        "description": "The channel's handle, such as @GoogleDevelopers, or its channel ID, which starts with UC (24 characters). Any public channel works, not just your own."
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to ask YouTube for new numbers. Each check uses 1 unit of your key's free 10,000 daily units. YouTube updates subscriber counts slowly, so every 30 minutes is plenty.",
        "default": 1800,
        "minimum": 300,
        "maximum": 86400
      }
    },
    "required": [
      "api_key",
      "channel"
    ]
  },
  "variables": {
    "groups": {
      "channel": {
        "label": "Channel"
      },
      "stats": {
        "label": "Statistics"
      }
    },
    "simple": {
      "channel_name": {
        "description": "The channel's title",
        "type": "string",
        "max_length": 22,
        "group": "channel",
        "example": "MAPLE ROAD COOKING"
      },
      "handle": {
        "description": "The channel's handle, such as @MAPLEROAD (empty when the channel has none)",
        "type": "string",
        "max_length": 22,
        "group": "channel",
        "example": "@MAPLEROADCOOKING"
      },
      "logo_tile": {
        "description": "A red tile, YouTube's colour, for decorating a line",
        "type": "string",
        "max_length": 1,
        "group": "channel",
        "example": "{63}"
      },
      "subscribers": {
        "description": "Subscriber count, short form (12.4K, 1.2M); HIDDEN when the channel hides it. YouTube rounds this down to 3 significant figures",
        "type": "string",
        "max_length": 6,
        "group": "stats",
        "example": "12.4K"
      },
      "subscribers_exact": {
        "description": "Subscriber count with thousands separators, as YouTube reports it (already rounded by YouTube); HIDDEN when hidden",
        "type": "string",
        "max_length": 13,
        "group": "stats",
        "example": "12,400"
      },
      "subscribers_hidden": {
        "description": "YES when the channel hides its subscriber count, otherwise NO",
        "type": "string",
        "max_length": 3,
        "group": "stats",
        "example": "NO"
      },
      "views": {
        "description": "Total views across all videos, short form (1.23M)",
        "type": "string",
        "max_length": 6,
        "group": "stats",
        "example": "1.23M"
      },
      "views_exact": {
        "description": "Total views with thousands separators",
        "type": "string",
        "max_length": 17,
        "group": "stats",
        "example": "1,234,567"
      },
      "videos": {
        "description": "Number of public videos, short form",
        "type": "string",
        "max_length": 6,
        "group": "stats",
        "example": "245"
      },
      "videos_exact": {
        "description": "Number of public videos with thousands separators",
        "type": "string",
        "max_length": 9,
        "group": "stats",
        "example": "245"
      },
      "subscribers_line": {
        "description": "Subscribers on one line, such as 12.4K SUBSCRIBERS",
        "type": "string",
        "max_length": 18,
        "group": "stats",
        "example": "12.4K SUBSCRIBERS"
      },
      "views_line": {
        "description": "Views on one line, such as 1.23M VIEWS",
        "type": "string",
        "max_length": 12,
        "group": "stats",
        "example": "1.23M VIEWS"
      },
      "videos_line": {
        "description": "Videos on one line, such as 245 VIDEOS",
        "type": "string",
        "max_length": 13,
        "group": "stats",
        "example": "245 VIDEOS"
      }
    }
  },
  "teaser": "{63} 12.4K SUBS",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "{63} MAPLE ROAD COOKING",
        "",
        "SUBSCRIBERS      12.4K",
        "VIEWS            1.23M",
        "VIDEOS             245",
        ""
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "{63} MAPLE ROAD",
        "12.4K SUBS",
        "1.23M VIEWS"
      ]
    },
    {
      "label": "Note Array (2 wide)",
      "device_type": "note_array",
      "notes_wide": 2,
      "notes_tall": 1,
      "rows": [
        "{63} MAPLE ROAD COOKING",
        "12.4K SUBSCRIBERS",
        "1.23M VIEWS - 245 VIDEOS"
      ]
    }
  ],
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "YouTube Stats on a FiestaBoard: channel name, subscribers, views and videos",
      "caption": "The default template",
      "primary": true
    }
  ],
  "demo": {
    "flagship": {
      "name": "YouTube Stats Demo",
      "template": [
        "{{youtube_stats.logo_tile}} {{youtube_stats.channel_name}}",
        "",
        "{{youtube_stats.subscribers_line}}",
        "{{youtube_stats.views_line}}",
        "{{youtube_stats.videos_line}}",
        ""
      ],
      "line_metadata": [
        {"alignment": "center", "wrap": false},
        {"alignment": "center", "wrap": false},
        {"alignment": "center", "wrap": false},
        {"alignment": "center", "wrap": false},
        {"alignment": "center", "wrap": false},
        {"alignment": "center", "wrap": false}
      ]
    },
    "note": {
      "name": "YouTube Stats (Note)",
      "template": [
        "{{youtube_stats.logo_tile}} {{youtube_stats.channel_name}}",
        "{{youtube_stats.subscribers}} SUBS",
        "{{youtube_stats.views_line}}"
      ],
      "line_metadata": [
        {"alignment": "left", "wrap": false},
        {"alignment": "left", "wrap": false},
        {"alignment": "left", "wrap": false}
      ]
    }
  }
}
